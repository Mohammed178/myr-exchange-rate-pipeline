{
  "name": "MYR Institutional Briefing",
  "dataColors": ["#12294A", "#C9A45C", "#2F6DA8", "#C07A2C", "#A9B4C0", "#5B7A99", "#8C6B3E", "#4F5B67"],
  "background": "#FFFFFF",
  "foreground": "#16202B",
  "tableAccent": "#12294A",
  "good": "#2F6DA8",
  "neutral": "#A9B4C0",
  "bad": "#C07A2C",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Georgia", "color": "#12294A" },
    "title":   { "fontSize": 13, "fontFace": "Georgia", "color": "#12294A" },
    "header":  { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#16202B" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#4F5B67" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F6F3EC" } }, "transparency": 0 }],
        "outspace":   [{ "color": { "solid": { "color": "#F6F3EC" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border":     [{ "show": true, "color": { "solid": { "color": "#D9D3C4" } }, "radius": 4 }],
        "dropShadow": [{ "show": false }],
        "title":      [{ "fontFamily": "Georgia", "fontSize": 13, "fontColor": { "solid": { "color": "#12294A" } } }]
      }
    }
  }
}
